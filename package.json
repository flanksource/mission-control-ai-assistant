{
  "name": "slack-mission-control-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run start:tenant",
    "start:tenant": "DOTENV_CONFIG_PATH=.env.tenant bun run src/tenant-bot/index.ts",
    "start:proxy": "DOTENV_CONFIG_PATH=.env.proxy bun run src/proxy/index.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check .",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "jwt:gen": "bun run scripts/gen-tenant-jwt.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.2",
    "@ai-sdk/google": "^3.0.2",
    "@ai-sdk/mcp": "^1.0.1",
    "@ai-sdk/openai": "^3.0.2",
    "@slack/bolt": "^4.0.0",
    "@slack/logger": "^4.0.0",
    "@slack/socket-mode": "^2.0.1",
    "ai": "^6.0.5",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "prettier": "^3.7.4",
    "@types/bun": "latest"
  },
  "module": "src/tenant-bot/index.ts",
  "peerDependencies": {
    "typescript": "^5"
  }
}
